{
  "tasks": {
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check supabase/functions/*/index.ts scripts/*.ts tests/",
    "test": "deno test --allow-read=.,../ios/Packages/WeatherCore/Tests tests/",
    "fixtures": "UPDATE_FIXTURES=1 deno test --allow-read=.,../ios/Packages/WeatherCore/Tests --allow-write=../ios/Packages/WeatherCore/Tests/WeatherCoreTests/Fixtures --allow-env=UPDATE_FIXTURES tests/today_test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
